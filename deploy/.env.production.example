# Copy to deploy/.env.production and fill in. Never commit the real file.

# Public host name (HTTPS via Let's Encrypt). The session cookie is only sent over HTTPS,
# so :80 (plain HTTP) works for a local test on http://localhost only.
DOMAIN=briefklar.example.com

POSTGRES_PASSWORD=change-me

# Which provider answers (anthropic or openai), which one takes over when it is down
# (empty = none), which one checks the analysis against the letter (empty = no check) and which
# one embeds the knowledge base (Anthropic has no embedding model, so empty = openai).
# After changing the embedding provider, run knowledge:seed.
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=openai
LLM_VERIFIER_PROVIDER=openai
LLM_EMBEDDING_PROVIDER=

# Paid tiers for real users in the EU (see "Notes on data protection" in the README)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
