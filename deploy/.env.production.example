# Copy to deploy/.env.production and fill in. Never commit the real file.

# Public host name (HTTPS via Let's Encrypt), or :80 for plain HTTP
DOMAIN=briefklar.example.com

# Login for the whole site. Create the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=briefklar
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

POSTGRES_PASSWORD=change-me

# Paid tier for real users in the EU (see "Notes on data protection" in the README)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
