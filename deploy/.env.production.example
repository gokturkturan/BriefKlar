# Copy to deploy/.env.production and fill in. Never commit the real file.

# Public host name (HTTPS via Let's Encrypt). The session cookie is only sent over HTTPS,
# so :80 (plain HTTP) works for a local test on http://localhost only.
DOMAIN=briefklar.example.com

POSTGRES_PASSWORD=change-me

# Which provider answers, which one takes over when it is down (empty = none) and which one
# embeds the knowledge base (empty = the main provider, or openai when it is anthropic)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
LLM_EMBEDDING_PROVIDER=

# Paid tier for real users in the EU (see "Notes on data protection" in the README)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
