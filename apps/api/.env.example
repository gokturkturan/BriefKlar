NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://briefklar:briefklar@localhost:5433/briefklar
REDIS_URL=redis://localhost:6380
UPLOAD_DIR=./uploads
WEB_ORIGIN=http://localhost:5173
# Which provider answers (gemini, anthropic, openai), which one takes over when it is down
# (empty = none) and which one embeds the knowledge base (default: the main provider, or openai
# when the main provider is anthropic). After changing the embedding provider, run knowledge:seed.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
LLM_EMBEDDING_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACK_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
