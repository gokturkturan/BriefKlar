{
  "name": "@briefklar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadlines:recompute": "tsx src/scripts/recomputeAllDeadlines.ts",
    "knowledge:seed": "tsx src/scripts/seedKnowledge.ts",
    "llm:reprice": "tsx src/scripts/repriceLlmCalls.ts",
    "eval": "tsx src/evals/runEval.ts"
  },
  "dependencies": {
    "@briefklar/shared": "*",
    "@google/genai": "^2.7.0",
    "@prisma/client": "^6.14.0",
    "bullmq": "^5.56.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
