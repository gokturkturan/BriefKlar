generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model User {
  id                String     @id @default(uuid())
  /// Stored in lower case; null for a guest who has not signed up (deleted after GUEST_DAYS)
  email             String?    @unique
  name              String?
  /// scrypt hash (src/auth/password.ts); null for the demo user from before accounts, who cannot sign in
  passwordHash      String?
  preferredLanguage String     @default("en")
  /// Federal state (e.g. "NW") for regional public holidays; null = nationwide only
  state             String?
  /// Letters are deleted this many days after upload (RETENTION_PERIODS); null = kept until deleted
  retentionDays     Int?
  createdAt         DateTime   @default(now())
  documents         Document[]
  reminders         Reminder[]
  sessions          Session[]
  llmCalls          LlmCall[]
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Document {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  fileKey      String         @unique
  mimeType     String
  sizeBytes    Int
  pageCount    Int?
  rawText      String?
  /// Day the letter arrived, entered by the user; replaces the assumed delivery date
  receivedDate DateTime?      @db.Date
  status       DocumentStatus @default(UPLOADED)
  errorMessage String?
  /// ErrorCode (packages/shared), so the web app can explain the error in the user's language
  errorCode    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  extractions  Extraction[]
  explanations Explanation[]
  deadlines    Deadline[]
  actionItems  ActionItem[]
  replyDrafts  ReplyDraft[]
  chatMessages ChatMessage[]
  reminders    Reminder[]
  llmCalls     LlmCall[]
  agentRuns    AgentRun[]

  @@index([userId, createdAt])
}

/// Structured LLM output, validated with LetterExtractionSchema (packages/shared)
model Extraction {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data          Json
  urgency       Urgency
  model         String
  promptVersion String
  createdAt     DateTime @default(now())

  translations AnalysisTranslation[]

  @@index([documentId])
}

/// Texts of an extraction in the user's language (AnalysisTranslationSchema), cached per language.
/// A new analysis of the letter gets new translations.
model AnalysisTranslation {
  id            String     @id @default(uuid())
  extractionId  String
  extraction    Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  language      String
  data          Json
  model         String
  promptVersion String
  createdAt     DateTime   @default(now())

  @@unique([extractionId, language])
}

/// Plain-language explanation, generated on request and cached per language
model Explanation {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  language      String
  content       String
  model         String
  promptVersion String
  createdAt     DateTime @default(now())

  @@unique([documentId, language])
}

model Deadline {
  id              String   @id @default(uuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  dueDate         DateTime @db.Date
  kind            String
  sourceText      String
  /// true if the start of a relative period was assumed (e.g. delivery by post)
  isEstimate      Boolean  @default(false)
  /// Steps of the calculation as data (DeadlineStepSchema), put into words by the web app
  steps           Json     @default("[]")
  confirmedByUser Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([dueDate])
}

model ActionItem {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean  @default(false)
  position   Int      @default(0)
}

/// German reply letter; the frame is built by code, the body written by the model
model ReplyDraft {
  id                  String   @id @default(uuid())
  documentId          String
  document            Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type                String
  contentDe           String
  contentUserLanguage String
  /// Language of contentUserLanguage
  language            String   @default("en")
  /// What the user asked for in their own words
  notes               String   @default("")
  model               String?
  promptVersion       String?
  createdAt           DateTime @default(now())

  @@index([documentId, createdAt])
}

/// A reminder about a letter. Code creates one for every upcoming deadline; users add their own,
/// on the reminders page or by asking the chat. A scheduled worker job fires reminders when due.
model Reminder {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// ReminderOrigin (packages/shared): DEADLINE, USER or CHAT
  origin       String
  remindOn     DateTime  @db.Date
  /// Written by the user or the chat in the user's language; empty for deadline reminders,
  /// whose text the web app writes in the reader's language
  note         String    @default("")
  /// Deadline reminders: the deadline (kind + wording), so recalculations update instead of duplicate
  deadlineKey  String?
  deadlineKind String?
  dueDate      DateTime? @db.Date
  /// When the worker fired the reminder (the point where e-mail or push would be sent)
  firedAt      DateTime?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([documentId, deadlineKey])
  @@index([userId, remindOn])
  @@index([remindOn])
}

/// Chat about one letter. Assistant messages keep which tools ran and which knowledge base
/// entries the answer used; tool results themselves are not stored.
model ChatMessage {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  /// ChatToolCallDto[] (packages/shared)
  toolCalls  Json?
  /// ChatSourceDto[]: knowledge base entries the answer is based on
  sources    Json     @default("[]")
  model      String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

/// Curated knowledge base for RAG (terms, procedures, official sources), seeded from
/// src/knowledge/entries.ts with `npm run knowledge:seed`
model KnowledgeEntry {
  id             String                       @id @default(uuid())
  /// Stable key of the entry in entries.ts, so seeding updates instead of duplicating
  slug           String                       @unique
  title          String
  content        String
  sourceUrl      String
  language       String                       @default("en")
  /// Prisma has no native vector type: read/write it with $queryRaw / $executeRaw
  embedding      Unsupported("vector(1536)")?
  /// Hash of the embedded text and model; the entry is embedded again when it changes
  contentHash    String
  embeddingModel String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
}

/// Every LLM request is logged for cost tracking and debugging
model LlmCall {
  id            String    @id @default(uuid())
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Whose letter it was, for the usage page; kept without the link when the account is deleted
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose       String
  provider      String
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  costUsd       Decimal   @db.Decimal(10, 6)
  latencyMs     Int
  success       Boolean
  errorMessage  String?
  /// The agent run and the agent that made the request; null for calls outside a run
  agentRunId    String?
  agentRun      AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agent         String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([agentRunId])
}

enum AgentRunTrigger {
  UPLOAD
  CHAT
  REPLY
}

enum AgentRunStatus {
  RUNNING
  DONE
  FAILED
}

/// One piece of work done by the agents for a letter, e.g. analysing an upload (src/agents)
model AgentRun {
  id         String          @id @default(uuid())
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  trigger    AgentRunTrigger
  status     AgentRunStatus  @default(RUNNING)
  /// Messages so far; the orchestrator stops the run at MAX_AGENT_HOPS
  hops       Int             @default(0)
  /// Model requests so far (MAX_LLM_CALLS_PER_RUN) and what they would cost on the paid tier
  llmCalls   Int             @default(0)
  costUsd    Decimal         @default(0) @db.Decimal(10, 6)
  /// Code of the error that ended the run
  errorCode  String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  messages AgentMessage[]
  calls    LlmCall[]

  @@index([documentId, startedAt])
}

/// A message between two agents; the payload follows AgentPayloadSchema (packages/shared)
model AgentMessage {
  id        String   @id @default(uuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  parentId  String?
  from      String
  to        String
  kind      String
  hop       Int
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, hop])
}
